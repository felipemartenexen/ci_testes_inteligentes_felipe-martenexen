# URL da aplicacao-alvo. Pode ser sobrescrita para apontar para um mirror.
BASE_URL=https://automationexercise.com

# Credenciais validas (somente para testes locais que dependem de login real).
# NAO commitar .env real. Para o CI publico, evite testes que precisem destas
# credenciais ou use GitHub Secrets.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
